---
import { site } from "../site.config";

const points = [
  {
    title: "Ingen live-tracking",
    text: "SFO'en kan ikke se, hvor du befinder dig på et kort — kun din forventede ankomsttid.",
  },
  {
    title: "Automatisk sletning",
    text: "Så snart du er ankommet (eller efter et fast tidsvindue), forsvinder beskeden automatisk fra skærmen.",
  },
  {
    title: "Ingen tunge IT-integrationer",
    text: "Kører direkte i en helt almindelig browser på en eksisterende skærm eller tablet.",
  },
];
---

<section id="privatliv" class="bg-dusk-900 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-300">
          Sikkerhed &amp; privatliv
        </h2>
        <p class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          Bygget med respekt for privatlivet
        </p>
        <p class="mt-5 leading-relaxed text-white/60">
          Vi ved, at data om børn kræver ekstra omtanke. Derfor er {site.productName}{" "}
          designet efter princippet om <em class="text-white">data-minimering</em>.
        </p>
      </div>
      <dl class="grid gap-px bg-white/10">
        {
          points.map((point) => (
            <div class="flex gap-4 bg-dusk-900 p-6">
              <svg class="mt-0.5 h-5 w-5 flex-none text-brand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M5 12.5 9.5 17 19 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div>
                <dt class="font-semibold text-white">{point.title}</dt>
                <dd class="mt-1 leading-relaxed text-white/60">{point.text}</dd>
              </div>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
