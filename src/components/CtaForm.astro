---
---

<section id="tilmelding" class="bg-brand-600 py-24 sm:py-32">
  <div class="mx-auto max-w-3xl px-6">
    <div class="text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Skal vi teste det i jeres SFO?
      </h2>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed text-white/80">
        Vi søger lige nu et par institutioner eller forældregrupper, der har
        lyst til at afprøve løsningen helt gratis og give feedback. Det
        kræver kun en skærm med internetadgang.
      </p>
    </div>

    <form
      id="pilot-form"
      class="mx-auto mt-10 grid max-w-xl gap-4 bg-sand-50 p-8 shadow-xl"
    >
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="name" class="block text-sm font-medium text-dusk-900">Dit navn</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="mt-1.5 w-full rounded-lg border border-dusk-900/15 px-3.5 py-2.5 text-dusk-900 outline-none ring-brand-400 focus:ring-2"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-dusk-900">E-mail</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="mt-1.5 w-full rounded-lg border border-dusk-900/15 px-3.5 py-2.5 text-dusk-900 outline-none ring-brand-400 focus:ring-2"
          />
        </div>
      </div>
      <div>
        <label for="school" class="block text-sm font-medium text-dusk-900">
          Skole / SFO <span class="text-dusk-900/40">(valgfri)</span>
        </label>
        <input
          id="school"
          name="school"
          type="text"
          class="mt-1.5 w-full rounded-lg border border-dusk-900/15 px-3.5 py-2.5 text-dusk-900 outline-none ring-brand-400 focus:ring-2"
        />
      </div>
      <div>
        <label for="message" class="block text-sm font-medium text-dusk-900">Besked</label>
        <textarea
          id="message"
          name="message"
          rows="3"
          placeholder="Skriv kort, hvis I er nysgerrige..."
          class="mt-1.5 w-full rounded-lg border border-dusk-900/15 px-3.5 py-2.5 text-dusk-900 outline-none ring-brand-400 focus:ring-2"
        ></textarea>
      </div>
      <button
        type="submit"
        class="mt-2 w-full bg-dusk-900 px-6 py-3.5 text-base font-semibold text-white transition hover:bg-dusk-800 disabled:opacity-60"
      >
        Send forespørgsel
      </button>
      <p id="form-status" class="text-center text-sm" role="status"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("pilot-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;

    const submitButton = form.querySelector("button[type=submit]") as HTMLButtonElement;
    submitButton.disabled = true;
    status.textContent = "Sender...";
    status.className = "text-center text-sm text-dusk-900/60";

    try {
      const formData = new FormData(form);
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.fromEntries(formData)),
      });

      if (!response.ok) throw new Error("Request failed");

      status.textContent = "Tak! Vi vender tilbage hurtigst muligt.";
      status.className = "text-center text-sm text-emerald-600";
      form.reset();
    } catch {
      status.textContent =
        "Noget gik galt. Skriv endelig direkte på mail i stedet.";
      status.className = "text-center text-sm text-red-600";
    } finally {
      submitButton.disabled = false;
    }
  });
</script>
