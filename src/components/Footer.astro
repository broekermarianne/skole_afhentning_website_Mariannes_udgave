---
import { site } from "../site.config";

const year = new Date().getFullYear();
---

<footer class="bg-dusk-900 py-10">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-6 text-sm text-white/40 sm:flex-row sm:justify-between"
  >
    <p>&copy; {year} {site.productName}. Et fritidsprojekt.</p>
    {
      site.contactEmail ? (
        <a href={`mailto:${site.contactEmail}`} class="hover:text-white/70">
          {site.contactEmail}
        </a>
      ) : null
    }
  </div>
</footer>
