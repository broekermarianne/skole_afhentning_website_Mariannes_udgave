---
import { site } from "../site.config";
---

<section id="om" class="bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-600">
      Historien bag
    </h2>
    <p class="mt-3 text-3xl font-semibold tracking-tight text-dusk-900 sm:text-4xl">
      Hvorfor bygger jeg det her?
    </p>
    <p class="mt-6 text-left leading-relaxed text-dusk-900/70 sm:text-center">
      Hej! Jeg hedder {site.authorName || "[dit navn]"} og arbejder til daglig
      som softwareudvikler i det offentlige. Jeg elsker at bygge løsninger,
      der fjerner små friktioner i hverdagen.
    </p>
    <p class="mt-4 text-left leading-relaxed text-dusk-900/70 sm:text-center">
      {site.productName} startede som et fritidsprojekt med ét mål: at opleve
      hele rejsen fra en god idé i ulvetimen til et færdigt, brugervenligt
      produkt i den virkelige verden. Det behøver ikke være et stort,
      forkromet system for at gøre en forskel.
    </p>
    {
      site.linkedinUrl ? (
        <a
          href={site.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-2 font-semibold text-brand-600 hover:text-brand-700"
        >
          Følg udviklingen på min LinkedIn-profil
        </a>
      ) : null
    }
  </div>
</section>
