---
---

<section id="top" class="relative overflow-hidden bg-dusk-900">
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,theme(colors.brand.700)/30%,transparent_55%),radial-gradient(circle_at_80%_0%,theme(colors.brand.500)/18%,transparent_45%)]"
  >
  </div>

  <div
    class="relative mx-auto grid max-w-6xl gap-16 px-6 pb-24 pt-36 sm:pb-32 sm:pt-44 lg:grid-cols-2 lg:items-center"
  >
    <div>
      <p
        class="mb-5 inline-flex items-center border border-white/20 bg-white/5 px-3.5 py-1.5 text-sm font-medium text-brand-200"
      >
        Til SFO'er, skoler og forældre
      </p>
      <h1
        class="text-4xl font-semibold leading-[1.1] tracking-tight text-white sm:text-5xl lg:text-6xl"
      >
        Ro i maven i ulvetimen.
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/70">
        Vis børnene, hvornår mor og far er på vej. Et enkelt dashboard til
        SFO'en og skolen, der med ét tryk i bilen besvarer dagens vigtigste
        spørgsmål: "Hvornår bliver jeg hentet?"
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href="#tilmelding"
          class="bg-brand-500 px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-900/40 transition hover:bg-brand-400"
        >
          Prøv det i jeres SFO
        </a>
        <a
          href="#saadan-virker-det"
          class="border border-white/25 px-7 py-3.5 text-base font-semibold text-white/90 transition hover:bg-white/10"
        >
          Se hvordan det virker
        </a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:mx-0 lg:ml-auto">
      <div class="border border-white/10 bg-dusk-800/80 p-3 shadow-2xl shadow-black/40 backdrop-blur">
        <div class="flex items-center justify-between px-3 pb-3 pt-1">
          <span class="font-mono text-xs text-white/40">SFO Solsikken — storskærm</span>
          <span class="flex items-center gap-1.5 font-mono text-xs text-brand-300">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-300"></span>
            Live
          </span>
        </div>
        <ul id="live-feed" class="space-y-px bg-white/5" aria-live="polite">
          <li
            data-row
            class="flex items-center gap-3 p-4 transition-all duration-500 ease-out bg-brand-500/15 ring-1 ring-inset ring-brand-400/30"
          >
            <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full text-sm font-semibold transition-colors duration-500 bg-brand-400/30 text-brand-100">M</span>
            <div class="flex-1">
              <p class="text-lg font-semibold text-white">Maria</p>
              <p class="font-mono text-sm transition-colors duration-500 text-brand-200">Fremme om 4 min.</p>
            </div>
            <svg class="h-6 w-6 flex-none transition-colors duration-500 text-brand-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M4 16.5 5.4 11a2 2 0 0 1 1.9-1.4h9.4a2 2 0 0 1 1.9 1.4l1.4 5.5" stroke-linecap="round" stroke-linejoin="round" />
              <rect x="3" y="16.5" width="18" height="3.2" rx="0.6" />
              <circle cx="7.5" cy="19.7" r="1.3" />
              <circle cx="16.5" cy="19.7" r="1.3" />
            </svg>
          </li>
          <li data-row class="flex items-center gap-3 p-4 transition-all duration-500 ease-out bg-dusk-900">
            <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full text-sm font-semibold transition-colors duration-500 bg-white/10 text-white">S</span>
            <div class="flex-1">
              <p class="text-lg font-semibold text-white/90">Søren</p>
              <p class="font-mono text-sm transition-colors duration-500 text-white/40">Fremme om 7 min.</p>
            </div>
            <svg class="h-6 w-6 flex-none transition-colors duration-500 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M4 16.5 5.4 11a2 2 0 0 1 1.9-1.4h9.4a2 2 0 0 1 1.9 1.4l1.4 5.5" stroke-linecap="round" stroke-linejoin="round" />
              <rect x="3" y="16.5" width="18" height="3.2" rx="0.6" />
              <circle cx="7.5" cy="19.7" r="1.3" />
              <circle cx="16.5" cy="19.7" r="1.3" />
            </svg>
          </li>
          <li data-row class="flex items-center gap-3 p-4 transition-all duration-500 ease-out bg-dusk-900">
            <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full text-sm font-semibold transition-colors duration-500 bg-white/10 text-white">A</span>
            <div class="flex-1">
              <p class="text-lg font-semibold text-white/90">Anne</p>
              <p class="font-mono text-sm transition-colors duration-500 text-white/40">Fremme om 9 min.</p>
            </div>
            <svg class="h-6 w-6 flex-none transition-colors duration-500 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M4 16.5 5.4 11a2 2 0 0 1 1.9-1.4h9.4a2 2 0 0 1 1.9 1.4l1.4 5.5" stroke-linecap="round" stroke-linejoin="round" />
              <rect x="3" y="16.5" width="18" height="3.2" rx="0.6" />
              <circle cx="7.5" cy="19.7" r="1.3" />
              <circle cx="16.5" cy="19.7" r="1.3" />
            </svg>
          </li>
        </ul>
      </div>
      <div class="absolute -bottom-6 -left-6 hidden border border-dusk-900/10 bg-sand-50 p-4 shadow-xl sm:block">
        <p class="text-xs font-medium text-dusk-900/50">Fra bil til skærm</p>
        <p class="font-mono text-sm font-medium text-dusk-900">under 2 sekunder</p>
      </div>
    </div>
  </div>
</section>

<script>
  const CAR_ICON =
    '<path d="M4 16.5 5.4 11a2 2 0 0 1 1.9-1.4h9.4a2 2 0 0 1 1.9 1.4l1.4 5.5" stroke-linecap="round" stroke-linejoin="round" /><rect x="3" y="16.5" width="18" height="3.2" rx="0.6" /><circle cx="7.5" cy="19.7" r="1.3" /><circle cx="16.5" cy="19.7" r="1.3" />';

  const QUEUE = [
    { initials: "T", name: "Thomas", eta: "Fremme om 11 min." },
    { initials: "C", name: "Camilla", eta: "Fremme om 13 min." },
    { initials: "L", name: "Lars", eta: "Fremme om 15 min." },
    { initials: "M", name: "Maria", eta: "Fremme om 4 min." },
    { initials: "S", name: "Søren", eta: "Fremme om 7 min." },
    { initials: "A", name: "Anne", eta: "Fremme om 9 min." },
  ];

  const list = document.getElementById("live-feed");
  let cursor = 0;

  function buildRow(entry: { initials: string; name: string; eta: string }) {
    const li = document.createElement("li");
    li.dataset.row = "true";
    li.className =
      "flex items-center gap-3 p-4 transition-all duration-500 ease-out opacity-0 -translate-y-3 bg-brand-500/15 ring-1 ring-inset ring-brand-400/30";
    li.innerHTML = `
      <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full text-sm font-semibold transition-colors duration-500 bg-brand-400/30 text-brand-100">${entry.initials}</span>
      <div class="flex-1">
        <p class="text-lg font-semibold text-white">${entry.name}</p>
        <p class="font-mono text-sm transition-colors duration-500 text-brand-200">${entry.eta}</p>
      </div>
      <svg class="h-6 w-6 flex-none transition-colors duration-500 text-brand-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">${CAR_ICON}</svg>
    `;
    return li;
  }

  function settle(row: HTMLElement) {
    const avatar = row.querySelector("span");
    const eta = row.querySelector("p.font-mono");
    const icon = row.querySelector("svg");
    row.classList.remove("bg-brand-500/15", "ring-brand-400/30");
    row.classList.add("bg-dusk-900");
    row.classList.remove("ring-1", "ring-inset");
    avatar?.classList.remove("bg-brand-400/30", "text-brand-100");
    avatar?.classList.add("bg-white/10", "text-white");
    eta?.classList.remove("text-brand-200");
    eta?.classList.add("text-white/40");
    icon?.classList.remove("text-brand-200");
    icon?.classList.add("text-white/40");
    row.querySelector("p.text-lg")?.classList.add("text-white/90");
  }

  function tick() {
    if (!list) return;
    const rows = Array.from(list.querySelectorAll("[data-row]")) as HTMLElement[];
    rows.forEach((row) => settle(row));

    const entry = QUEUE[cursor % QUEUE.length];
    cursor += 1;
    const newRow = buildRow(entry);
    list.prepend(newRow);

    const last = rows[rows.length - 1];
    last?.classList.add("opacity-0", "translate-y-3");

    requestAnimationFrame(() => {
      newRow.classList.remove("opacity-0", "-translate-y-3");
    });

    window.setTimeout(() => {
      last?.remove();
    }, 550);
  }

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (list && !prefersReducedMotion) {
    window.setInterval(tick, 4000);
  }
</script>
