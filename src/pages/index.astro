---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import InteractiveDemo from "../components/InteractiveDemo.astro";
import Benefits from "../components/Benefits.astro";
import Privacy from "../components/Privacy.astro";
import About from "../components/About.astro";
import CtaForm from "../components/CtaForm.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Nav />
  <Hero />
  <HowItWorks />
  <InteractiveDemo />
  <Benefits />
  <Privacy />
  <About />
  <CtaForm />
  <Footer />
</Base>
<script>
  const KEY = "splash_count";
  const MAX = 3;
  const GIF_SECONDS = 5;

  const count = parseInt(localStorage.getItem(KEY) || "0");

  if (count < MAX) {
    localStorage.setItem(KEY, String(count + 1));

    const overlay = document.createElement("div");
    overlay.style.cssText = `
      position: fixed; inset: 0; background: #000;
      display: flex; align-items: center; justify-content: center;
      z-index: 9999; cursor: pointer;
    `;

    const img = document.createElement("img");
    img.src = "/90er_aeble_skolecomputer.gif";
    img.style.cssText = "max-width: 100%; max-height: 100vh; object-fit: contain;";

    overlay.appendChild(img);
    document.body.appendChild(overlay);

    const remove = () => overlay.remove();
    setTimeout(remove, GIF_SECONDS * 1000);
    overlay.addEventListener("click", remove);
  }
</script>
